# Paradiso - configuración local de ejemplo
# Copia este fichero como .env y adapta los valores a tu entorno.
# El fichero .env real no debe subirse a GitHub.

PARADISO_BROKER_URL=tcp://localhost:61616
PARADISO_CLIENT_ID=paradiso-business-unit
PARADISO_TOPICS=TicketmasterEvent,TflJourney

# Si ejecutas business-unit desde IntelliJ con Working directory = $MODULE_WORKING_DIR$,
# normalmente el event store estará en ../eventstore.
# Si ejecutas desde la raíz del proyecto, usa eventstore.
# Si tienes dudas, usa una ruta absoluta.
PARADISO_EVENTSTORE_PATH=../eventstore

PARADISO_API_PORT=7000

# false = solo datos históricos, útil para defensa o demo rápida sin ActiveMQ.
# true = carga histórica + consumo en tiempo real desde ActiveMQ.
PARADISO_SUBSCRIBER_ENABLED=false

PARADISO_RECONNECT_DELAY_MS=5000
PARADISO_RECONNECT_MAX_DELAY_MS=30000